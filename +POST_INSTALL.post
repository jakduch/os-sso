#!/bin/sh

set -u

SYNC=${SSO_SYNC:-/usr/local/opnsense/scripts/OPNsense/SSO/sync_openvpn.php}
GUARD=${SSO_GUARD:-/usr/local/etc/rc.d/os-sso-vpn-guard}

# Repair only unsafe running instances; never drop healthy tunnels for an upgrade.
OUT=$("$SYNC" --repair-running 2>&1)
SYNC_STATUS=$?
printf '%s\n' "$OUT"
case "$SYNC_STATUS:$OUT" in
    0:OK:*) ;;
    *)
        echo "os-sso: OpenVPN reconciliation needs attention; continuing package installation" >&2
        logger -t os-sso -p daemon.err "OpenVPN package reconciliation: $(printf '%s' "$OUT" | tr '\n' ' ')" || true
        ;;
esac

if "$GUARD" onestatus >/dev/null 2>&1; then
    GUARD_ACTION=onerestart
else
    GUARD_ACTION=onestart
fi
if ! "$GUARD" "$GUARD_ACTION"; then
    echo "os-sso: runtime guard could not be reloaded; continuing package installation" >&2
    logger -t os-sso -p daemon.err "OpenVPN runtime guard could not be reloaded after package installation" || true
fi

# Plugin failures must not abort firmware/package upgrades. Configuration events
# retry repair and diagnostics expose the guard service status.
exit 0
