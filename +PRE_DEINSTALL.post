#!/bin/sh

set -u

# pkg also runs this hook on upgrade. The verifier remains installed in that case;
# leave live tunnels and their guard alone until the new post-install reloads it.
if [ "${PKG_UPGRADE:-false}" = "true" ]; then
    exit 0
fi

GUARD=${SSO_GUARD:-/usr/local/etc/rc.d/os-sso-vpn-guard}
SYNC=${SSO_SYNC:-/usr/local/opnsense/scripts/OPNsense/SSO/sync_openvpn.php}
STATUS=0
"$GUARD" onestop || STATUS=1
"$SYNC" --stop-managed || STATUS=1
if [ "$STATUS" -ne 0 ]; then
    echo "os-sso: deinstallation could not prove every managed OpenVPN instance is stopped" >&2
fi
exit "$STATUS"
